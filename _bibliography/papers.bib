@article{huang2026finvision,
  selected={true},
  title={Frontiers in FinTech: Multimodal Foundation Models for Financial Reporting and Decision Science},
  author={Huang, Yulu and Yu, Niannian and Yang, Yaxin and Huang, Yong},
  abstract={We propose FinVision, a multimodal large language model for financial analysis that jointly reasons over text, tables, images, and scanned documents. FinVision integrates vision-language understanding with domain-specific financial reasoning and cross-modal evidence verification, enabling unified financial information extraction, valuation, and audit risk assessment. A two-stage training strategy combines large-scale public financial pre-training with institution-specific investment fine-tuning. Experiments on 200 listed companies show a 19% reduction in valuation error over the strongest baseline, while a study with 48 accounting and investment professionals demonstrates a 51% reduction in task completion time.},
  year={2026},
  journal={AAA AIS-SET -- JISC Track},
  arxiv={2608.22724},
  website={https://github.com/yuluhuang324/Frontiers-in-FinTech},
  preview={frontiers_workflow.PNG}
}

@article{huang2026accountagent,
  selected={true},
  title={AccountAgent: AI Accounting Assistant System},
  author={Huang, Yulu and Yu, Niannian and Yang, Yaxin and Lv, Jinpeng},
  abstract={We develop an AI-powered accounting assistant that integrates machine learning, NLP, and data visualization to automate bookkeeping, financial reporting, and data analysis. By mining historical financial data and identifying operating trends, the system provides real-time insights for decision-making, risk management, and compliance, reducing manual effort and human error. It transforms traditional accounting from repetitive bookkeeping toward intelligent, management-oriented financial decision support.},
  journal={Manuscript under review at the 44th International Conference on Machine Learning (ICML 2027)},
  arxiv={2608.16635},
  website={https://github.com/yuluhuang324/AccountAgent},
  preview={accountagent_workflow.PNG}
}
@article{huang2026finvision,
  selected={true},
  title={Frontiers in FinTech: Multimodal Foundation Models for Financial Reporting and Decision Science},
  author={Huang, Yulu and Yu, Niannian and Yang, Yaxin and Huang, Yong},
  abstract={We propose FinVision, a multimodal large language model for financial analysis that jointly reasons over text, tables, images, and scanned documents. FinVision integrates vision-language understanding with domain-specific financial reasoning and cross-modal evidence verification, enabling unified financial information extraction, valuation, and audit risk assessment. A two-stage training strategy combines large-scale public financial pre-training with institution-specific investment fine-tuning. Experiments on 200 listed companies show a 19% reduction in valuation error over the strongest baseline, while a study with 48 accounting and investment professionals demonstrates a 51% reduction in task completion time.},
  year={2026},
  journal={AAA AIS-SET -- JISC Track},
  arxiv={2608.22724},
  website={https://github.com/yuluhuang324/Frontiers-in-FinTech},
  preview={frontiers_workflow.PNG}
}

@article{huangaccountagent,
  selected={true},
  title={AccountAgent: AI Accounting Assistant System},
  author={Huang, Yulu and Yu, Niannian and Yang, Yaxin and Lv, Jinpeng},
  abstract={We develop an AI-powered accounting assistant that integrates machine learning, NLP, and data visualization to automate bookkeeping, financial reporting, and data analysis. By mining historical financial data and identifying operating trends, the system provides real-time insights for decision-making, risk management, and compliance, reducing manual effort and human error. It transforms traditional accounting from repetitive bookkeeping toward intelligent, management-oriented financial decision support.},
  year={2026},
  journal={Manuscript under review at the 44th International Conference on Machine Learning (ICML 2027)},
  arxiv={2608.16635},
  website={https://github.com/yuluhuang324/AccountAgent},
  preview={accountagent_workflow.PNG}
}

@article{huang2026humanai,
  selected={true},
  title={Human--AI Collaboration in Accounting Judgment: A Proposed Cognitive Coding Scheme and a Rule-Based Adaptive Collaboration Protocol},
  author={Huang, Yulu and Xiao, Lijun and Wang, Gang},
  abstract={Large language models create an accounting information systems design problem: how should evidence production, professional evaluation, and responsibility be allocated between a model and an accountant? We propose a Cognitive Decomposition for Accounting Judgment (CDAJ) coding scheme crossing four process stages with information-intensive and evaluative demands. An Adaptive Collaboration Protocol (ACP) connects allocation rules to an independent human estimate, source-linked model output, structured verification, and a documented human conclusion. Two separately returned coding forms cover 20 constructed cases. A disclosed primary-only analysis retains unresolved auxiliary response formats. Raw agreement is 19/20 for unitization, 20/20 for stage, and 18/20 for demand. On 14 jointly single, codable cases, nominal Cohen's kappa is 1.000 for stage and 0.752 for I/E/M demand profiles; only 12/20 cases are jointly resolved to I or E. A public-disclosure diagnostic searches 1,406 pages for 18 numeric reference cards from three banks' annual reports. Adding a value/period/unit co-occurrence gate to BM25 with identical query information does not improve designated-origin recovery at ranks one or three: both methods recover 13/18 origins at rank one and 18/18 within three ranks. A post-hoc audit distinguishes page recovery from requested table-cell verification. Synthetic checks examine event ordering and record integrity; Gaussian planning experiments examine a future effectiveness evaluation. A separate source-response audit records adverse or unclear statuses in 16/36 returned records. These bounded findings concern coding repeatability and implementation properties. They do not establish an optimal allocation, a validated taxonomy, or improved professional judgment.},
  year={2026},
  journal={Working paper},
  arxiv={2611.29442},
  preview={humanai_cdaj_matrix.PNG}
}